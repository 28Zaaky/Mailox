# MAILOX — Khaøtic Security
# Copy to .env and fill in real values. Never commit .env.

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=MAILOX
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1

# ─── Security keys (minimum 32 chars each, generate with: openssl rand -hex 32) ──
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
REFRESH_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32_different
MASTER_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32_different_again

# ─── Token expiry ────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mailox:mailox_pass@db:5432/mailox
DATABASE_URL_SYNC=postgresql+psycopg2://mailox:mailox_pass@db:5432/mailox

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redis_pass@redis:6379/0

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_RPM=10
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ─── CORS (comma-separated list of allowed origins) ──────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── MFA ─────────────────────────────────────────────────────────────────────
MFA_ISSUER=MAILOX

# ─── Celery workers ───────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:redis_pass@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redis_pass@redis:6379/2
SCAN_TASK_TIMEOUT_SECONDS=120
SCAN_TASK_MAX_RETRIES=2
SCAN_TASK_RETRY_COUNTDOWN=30
WORKER_CONCURRENCY=4
SCAN_STALL_TIMEOUT_SECONDS=180
