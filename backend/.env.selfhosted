# MAILOX self-hosted configuration (manual install: uvicorn + Celery + Vite on this machine)
# setup-selfhosted.sh / setup-selfhosted.ps1 copy this file to backend/.env and replace
# the three CHANGEME keys. Manual copy: generate each key with
#   python -c "import secrets; print(secrets.token_hex(32))"
# The Docker path (start.sh / start.ps1) does not use this file: it writes backend/.env.docker.

# ── Edition ───────────────────────────────────────────────────────────────────
# The code default is "saas" (fail-safe). A self-hosted install must set this.
MAILOX_EDITION=selfhosted

# No-login local session: POST /auth/local-session opens a platform-admin session
# without credentials. Only that route is restricted to loopback peers (127.0.0.0/8,
# ::1); with X-Forwarded-For present (Vite dev proxy), every forwarded address must be
# loopback too. The rest of the API (login, scans, ...) answers whatever can reach it,
# so keep uvicorn bound to 127.0.0.1 and never expose it without a reverse proxy and
# LOCAL_SESSION_ENABLED=false (accounts mode).
LOCAL_SESSION_ENABLED=true
# Number of reverse proxies in front of the API that append X-Forwarded-For.
# 0 = uvicorn reached directly or through the Vite dev proxy.
TRUSTED_PROXY_COUNT=0

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mailox:mailox@localhost:5432/mailox
DATABASE_URL_SYNC=postgresql+psycopg2://mailox:mailox@localhost:5432/mailox

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Secrets (>= 32 chars, all distinct; placeholders are rejected at startup) ──
SECRET_KEY=CHANGEME_generate_with_command_above_1111111111111111
REFRESH_SECRET_KEY=CHANGEME_generate_with_command_above_2222222222222222
MASTER_ENCRYPTION_KEY=CHANGEME_generate_with_command_above_3333333333333333

# ── HTTP ──────────────────────────────────────────────────────────────────────
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

# ── Offensive modules (enabled by default in self-hosted) ─────────────────────
# Self-hosted scans run from YOUR IP. You are responsible for having authorisation
# to test the target domain. Set to false to disable individually.
WEB_ACTIVE_PROBE_ENABLED=true
CRED_PROBE_ENABLED=true
# CANARY_EMAIL=you@example.com   # set to an address you control to enable open-relay / spoofing probes

# ── Optional API keys ─────────────────────────────────────────────────────────
# NVD_API_KEY=       # NVD CVE lookups (higher rate limits)
# GITHUB_TOKEN=      # GitHub code search for credential exposure
# INTELX_API_KEY=    # IntelligenceX search
