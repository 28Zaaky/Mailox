# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mailox:CHANGEME@localhost:5432/mailox
DATABASE_URL_SYNC=postgresql+psycopg2://mailox:CHANGEME@localhost:5432/mailox

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGEME_at_least_32_hex_chars_aaaaaaaaaaaaaaaaaaaaa
REFRESH_SECRET_KEY=CHANGEME_different_from_secret_key_bbbbbbbbbbb
MASTER_ENCRYPTION_KEY=CHANGEME_different_from_both_above_cccccccccc

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
ALLOWED_ORIGINS=https://your-domain.com
ALLOWED_HOSTS=your-domain.com

# ── Edition ───────────────────────────────────────────────────────────────────
# saas:       multi-tenant SaaS. Accounts via invite only (admin approves access requests),
#             domains must be proven (DNS TXT) before they can be scanned.
# selfhosted: open-source install, no domain verification (see backend/.env.selfhosted).
# The code default is saas (fail-safe): self-hosted installs must set selfhosted explicitly.
MAILOX_EDITION=saas
# Local session mode (selfhosted only). Never enable on SaaS.
# When true, only a strict loopback client is accepted, resolved with TRUSTED_PROXY_COUNT:
#   - API reached directly (uvicorn --host 127.0.0.1, Vite dev proxy): keep
#     TRUSTED_PROXY_COUNT=0. The peer must be loopback and, if X-Forwarded-For is set
#     (the Vite proxy sets it), every forwarded address must be loopback too.
#   - API behind ONE reverse proxy running on the same host (nginx -> 127.0.0.1:8000):
#     TRUSTED_PROXY_COUNT=1, and that proxy must append $remote_addr to X-Forwarded-For.
#   - Bundled docker-compose stack: the browser reaches nginx through Docker's port
#     forwarding, so the API sees the Docker bridge gateway (172.x.0.1), never loopback.
LOCAL_SESSION_ENABLED=false
# saas: invite validity and admin notification
ACCESS_INVITE_TTL_HOURS=168
# ADMIN_NOTIFY_EMAIL=you@your-domain.com   # receives new access requests

# ── Email (invites, password reset) ───────────────────────────────────────────
# Without SMTP_HOST, emails are written to the API log instead of being sent.
FRONTEND_URL=https://app.your-domain.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=noreply@your-domain.com
# SMTP_PASSWORD=
# SMTP_FROM=noreply@your-domain.com
# SMTP_USE_TLS=false   # true = implicit TLS (port 465); false + port 587 = STARTTLS

# ── Tokens ────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_RPM=10
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ── Workers ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
SCAN_TASK_TIMEOUT_SECONDS=120
SCAN_TASK_MAX_RETRIES=2

# ── Scanning ──────────────────────────────────────────────────────────────────
WEBMAIL_REQUEST_TIMEOUT=10.0
WEBMAIL_MAX_SUBDOMAINS=5
SECRET_SCAN_MAX_FILE_SIZE_MB=10
SECRET_SCAN_MAX_FILES=50
SECRET_SCAN_MAX_ARCHIVE_SIZE_MB=50

# ── Optional ──────────────────────────────────────────────────────────────────
# NVD_API_KEY=your_nvd_api_key_for_higher_rate_limits
# TRUSTED_PROXY_COUNT=1   # set to 1 behind nginx, 2 behind nginx+cloudflare
